.TH openalex-snapshot-repair 1
.SH NAME
openalex-snapshot-repair \- reconvert files from verify report failures
.SH SYNOPSIS
.B openalex-snapshot repair_convert
--from-verify-report PATH [OPTIONS]
.SH EXAMPLE
openalex-snapshot repair_convert --root-dir /data --from-verify-report /data/.openalex-snapshot_metadata/reports/verify_convert-123456.json
